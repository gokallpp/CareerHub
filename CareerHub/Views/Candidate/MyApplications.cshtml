@model List<CareerHub.Models.JobApplication>

@{
    ViewData["Title"] = "Başvurularım";
}

<div class="container py-5">

    <div class="mb-5">

        <h1 class="fw-bold">
            Başvurularım
        </h1>

        <p class="text-muted">
            Yaptığınız iş başvurularını ve güncel durumlarını takip edin.
        </p>

    </div>

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <h4>
                    Henüz bir başvurunuz yok.
                </h4>

                <p class="text-muted">
                    Size uygun iş ilanlarını keşfederek başvuru yapabilirsiniz.
                </p>

                <a asp-controller="JobPostings"
                   asp-action="Index"
                   class="btn btn-primary">

                    İş İlanlarını Gör

                </a>

            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var application in Model)
            {
                <div class="col-lg-6">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between mb-3">

                                <div>

                                    <h4 class="fw-bold mb-1">
                                        @application.JobPosting.Title
                                    </h4>

                                    @if (application.JobPosting.Company != null)
                                    {
                                        <span class="text-muted">
                                            @application.JobPosting.Company.Name
                                        </span>
                                    }

                                </div>

                                @if (application.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Bekliyor
                                    </span>
                                }
                                else if (application.Status == "Reviewed")
                                {
                                    <span class="badge bg-info">
                                        İncelendi
                                    </span>
                                }
                                else if (application.Status == "Interview")
                                {
                                    <span class="badge bg-primary">
                                        Görüşme
                                    </span>
                                }
                                else if (application.Status == "Accepted")
                                {
                                    <span class="badge bg-success">
                                        Kabul Edildi
                                    </span>
                                }
                                else if (application.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Reddedildi
                                    </span>
                                }

                            </div>

                            <p class="text-muted mb-2">
                                📍 @application.JobPosting.Location
                            </p>

                            <p class="text-muted">
                                Başvuru Tarihi:
                                @application.AppliedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </p>

                            <a asp-controller="JobPostings"
                               asp-action="Details"
                               asp-route-id="@application.JobPostingId"
                               class="btn btn-outline-primary">

                                İlanı Görüntüle

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>